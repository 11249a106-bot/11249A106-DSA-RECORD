#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};

struct node *top = NULL;

void push(int x) {
    struct node *n = malloc(sizeof(struct node));
    n->data = x;
    n->next = top;
    top = n;
}

int pop() {
    if (!top) {
        printf("Stack Underflow\n");
        return -1;
    }
    struct node *temp = top;
    int x = temp->data;
    top = top->next;
    free(temp);
    return x;
}

int peek() {
    if (!top) {
        printf("Stack is empty\n");
        return -1;
    }
    return top->data;
}

void display() {
    struct node *temp = top;
    while (temp) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
    printf("\n");
}

int main() {
    int choice, x;

    while (1) {
        printf("\n1.Push\n2.Pop\n3.Peek\n4.Display\n5.Exit\n");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                scanf("%d", &x);
                push(x);
                break;
            case 2:
                x = pop();
                if (x != -1) printf("Popped: %d\n", x);
                break;
            case 3:
                x = peek();
                if (x != -1) printf("Top: %d\n", x);
                break;
            case 4:
                display();
                break;
            case 5:
                exit(0);
        }
    }
    return 0;
}
