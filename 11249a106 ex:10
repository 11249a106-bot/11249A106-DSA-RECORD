#include <stdio.h>
#include <stdlib.h>

#define MAX 100

int adj[MAX][MAX], visited[MAX];
int n;

void dfs(int v) {
    printf("%d ", v);
    visited[v] = 1;

    for (int i = 0; i < n; i++) {
        if (adj[v][i] && !visited[i])
            dfs(i);
    }
}

void bfs(int start) {
    int queue[MAX], front = 0, rear = 0;
    int visitedBFS[MAX] = {0};

    queue[rear++] = start;
    visitedBFS[start] = 1;

    while (front < rear) {
        int v = queue[front++];
        printf("%d ", v);

        for (int i = 0; i < n; i++) {
            if (adj[v][i] && !visitedBFS[i]) {
                queue[rear++] = i;
                visitedBFS[i] = 1;
            }
        }
    }
}

int main() {
    int edges, u, v;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &edges);

    for (int i = 0; i < edges; i++) {
        scanf("%d %d", &u, &v);
        adj[u][v] = 1;
        adj[v][u] = 1; // comment this line for directed graph
    }

    printf("DFS starting from vertex 0: ");
    for(int i=0;i<n;i++) visited[i]=0;
    dfs(0);
    printf("\nBFS starting from vertex 0: ");
    bfs(0);
    printf("\n");

    return 0;
}
